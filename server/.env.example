PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/portfolio
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app
NODE_ENV=development

# Where contact form emails are delivered
RECIPIENT_EMAIL=dinakardj2209@gmail.com

# Option A — Resend (recommended for Render/production)
# Sign up: https://resend.com — free tier, works reliably on cloud hosts
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=Portfolio Contact <onboarding@resend.dev>

# Option B — Gmail SMTP (works locally; often blocked on Render)
EMAIL_FROM_NAME=Portfolio Contact
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dinakardj2209@gmail.com
SMTP_PASS=your_gmail_app_password_no_spaces
